---
// about.astro - Bento Desktop Optimized with Bilingual i18n
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';

const techStack = [
  { name: 'Android', category: { en: 'Platform', zh: '開發平台' } },
  { name: 'Kotlin', category: { en: 'Language', zh: '核心語言' } },
  { name: 'Compose', category: { en: 'UI Toolkit', zh: 'UI 框架' } },
  { name: 'Git', category: { en: 'Version Control', zh: '版本控制' } },
];
---

<BaseLayout
  title="About — Kai Liu"
  description="Student & Android Indie Maker. Less text, better software."
>
  <div class="space-y-16 sm:space-y-20 py-2">
    <!-- Desktop Bento Grid Section (md:grid-cols-12) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      <!-- Left Column (md:col-span-7) -->
      <div class="md:col-span-7 flex flex-col gap-5">
        <!-- Header & Identity Card -->
        <div class="p-6 sm:p-8 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4">
          <div class="space-y-1">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
              <span data-lang="en">About</span>
              <span data-lang="zh">關於我</span>
            </span>
            <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 font-sans">
              Kai Liu
            </h1>
          </div>

          <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800/80 space-y-3">
            <div class="space-y-1">
              <span class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                <span data-lang="en">Identity</span>
                <span data-lang="zh">身份</span>
              </span>
              <div class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100">
                <span data-lang="en">Student &amp; Android Indie Maker</span>
                <span data-lang="zh">學生 &amp; Android 獨立創作者</span>
              </div>
            </div>

            <div class="space-y-1 pt-1">
              <span class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
                <span data-lang="en">Focus</span>
                <span data-lang="zh">核心專注</span>
              </span>
              <div class="text-base sm:text-lg font-semibold text-zinc-800 dark:text-zinc-200 font-mono">
                Android &bull; Kotlin &bull; Jetpack Compose
              </div>
            </div>
          </div>
        </div>

        <!-- Philosophy Card -->
        <div class="p-6 sm:p-8 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/80 dark:bg-zinc-900/60 flex-1 flex flex-col justify-center space-y-2">
          <span class="text-xs font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500">
            <span data-lang="en">Philosophy</span>
            <span data-lang="zh">創作理念</span>
          </span>
          <blockquote class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 font-sans leading-tight">
            <span data-lang="en">&ldquo;Less text, better software.&rdquo;</span>
            <span data-lang="zh">&ldquo;極簡克制，精工打造更好用的軟體。&rdquo;</span>
          </blockquote>
        </div>
      </div>

      <!-- Right Column (md:col-span-5) -->
      <div class="md:col-span-5 flex flex-col gap-5">
        <!-- Tech Stack Visual Card -->
        <div class="p-6 sm:p-7 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
            <span data-lang="en">Tech Stack</span>
            <span data-lang="zh">技術架構</span>
          </span>

          <div class="grid grid-cols-2 gap-2.5">
            {
              techStack.map((tech) => (
                <div class="p-3 rounded-2xl border border-zinc-100 dark:border-zinc-800/90 bg-zinc-50/70 dark:bg-zinc-900/80 space-y-0.5">
                  <div class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
                    <span data-lang="en">{tech.category.en}</span>
                    <span data-lang="zh">{tech.category.zh}</span>
                  </div>
                  <div class="text-sm font-bold text-zinc-900 dark:text-zinc-100">
                    {tech.name}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Connect Cards -->
        <div class="p-6 sm:p-7 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 space-y-4 flex-1 flex flex-col justify-between">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
            <span data-lang="en">Connect</span>
            <span data-lang="zh">社群連結</span>
          </span>

          <div class="space-y-2.5">
            <a
              href="https://github.com/binno894894-dotcom"
              target="_blank"
              rel="noopener noreferrer"
              class="p-3.5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 flex items-center justify-between group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all"
            >
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-zinc-700 dark:text-zinc-300 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                  <path d="M9 18c-4.51 2-5-2-7-2" />
                </svg>
                <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100">GitHub</span>
              </div>
              <span class="text-xs font-mono text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 group-hover:translate-x-0.5 transition-all">
                &rarr;
              </span>
            </a>

            <a
              href="https://www.threads.com/@stu6yen9ineer"
              target="_blank"
              rel="noopener noreferrer"
              class="p-3.5 rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 flex items-center justify-between group hover:border-zinc-300 dark:hover:border-zinc-700 transition-all"
            >
              <div class="flex items-center gap-3">
                <svg class="w-4 h-4 text-zinc-700 dark:text-zinc-300 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 7a5 5 0 0 0-5 5c0 3 2.5 5 5 5s5-2 5-5a5 5 0 0 0-5-5" />
                </svg>
                <span class="text-sm font-bold text-zinc-900 dark:text-zinc-100">Threads</span>
              </div>
              <span class="text-xs font-mono text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 group-hover:translate-x-0.5 transition-all">
                &rarr;
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Apps by Kai Showcase Section (Bottom of About Page) -->
    <section class="space-y-6 text-center pt-8 border-t border-zinc-200/70 dark:border-zinc-800/80">
      <div class="space-y-3 flex flex-col items-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 font-sans">
          <span data-lang="en">Apps by Kai</span>
          <span data-lang="zh">Kai 的應用程式</span>
        </h2>
        <p class="text-sm sm:text-base text-zinc-500 dark:text-zinc-400 max-w-md mx-auto leading-relaxed">
          <span data-lang="en">Apps designed with simplicity in mind.</span>
          <span data-lang="zh">以極簡為核心打造的實用 Android 工具。</span>
        </p>
        <div class="pt-1">
          <a
            href="/apps"
            class="inline-flex items-center justify-center px-5 py-2 rounded-full bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900 text-xs font-semibold hover:opacity-90 transition-opacity shadow-xs"
          >
            <span data-lang="en">View All</span>
            <span data-lang="zh">查看全部</span>
          </a>
        </div>
      </div>

      <!-- App Icon Grid / List (Centered) -->
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 pt-4">
        {
          apps.map((app) => (
            <a
              href={`/apps/${app.slug}`}
              class="group flex flex-col items-center text-center space-y-3 cursor-pointer"
            >
              <!-- Large App Icon Container (rounded-[2rem]) -->
              <div class="w-36 h-36 sm:w-40 sm:h-40 rounded-[2rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/80 flex items-center justify-center p-6 transition-all duration-300 group-hover:scale-105 group-hover:border-zinc-300 dark:group-hover:border-zinc-700 shadow-xs">
                <img
                  src={app.icon}
                  alt={`${app.name} icon`}
                  class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl shadow-xs object-contain"
                  loading="lazy"
                />
              </div>

              <!-- Labels Below Icon -->
              <div class="space-y-1">
                <div class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:underline">
                  {app.name}
                </div>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-[150px] leading-relaxed mx-auto">
                  <span data-lang="en">{app.shortTagline.en}</span>
                  <span data-lang="zh">{app.shortTagline.zh}</span>
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
