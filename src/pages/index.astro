---
// index.astro - Easlo Minimalist Overhaul with Bilingual i18n & Multi-App Grid
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';

const featuredApp = apps[0];
---

<BaseLayout
  title="Kai Liu — Android Developer & Indie Maker"
  description="Building minimal Android apps."
>
  <div class="space-y-16 sm:space-y-20 py-2">
    <!-- Hero Section (Extreme Minimalism) -->
    <section class="space-y-4 text-center sm:text-left">
      <div class="space-y-1.5">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 font-sans">
          Kai Liu
        </h1>
        <p class="text-base sm:text-lg font-medium text-zinc-600 dark:text-zinc-400">
          <span data-lang="en">Android Developer &amp; Indie Maker</span>
          <span data-lang="zh">Android 開發者 &amp; 獨立創作者</span>
        </p>
        <p class="text-xs sm:text-sm font-mono text-zinc-500 dark:text-zinc-500 pt-0.5">
          <span data-lang="en">A student building Android apps that make everyday life a little better.</span>
          <span data-lang="zh">一個想改變生活的學生，打造讓日常更美好的 Android 工具。</span>
        </p>
      </div>

      <!-- Minimal Icon Actions -->
      <div class="flex items-center justify-center sm:justify-start gap-2.5 pt-2">
        <a
          href="https://github.com/binno894894-dotcom"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="w-9 h-9 rounded-lg border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-all duration-200 active:scale-90"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
        </a>

        <a
          href="https://www.threads.com/@stu6yen9ineer"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Threads"
          class="w-9 h-9 rounded-lg border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-all duration-200 active:scale-90"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 7a5 5 0 0 0-5 5c0 3 2.5 5 5 5s5-2 5-5a5 5 0 0 0-5-5" />
          </svg>
        </a>

        <a
          href="/apps"
          class="inline-flex items-center gap-1.5 px-3 h-9 rounded-lg border border-zinc-200 dark:border-zinc-800 text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 transition-all duration-200 active:scale-95"
        >
          <span data-lang="en">All Apps</span>
          <span data-lang="zh">全部應用</span>
          <span>&rarr;</span>
        </a>
      </div>
    </section>

    <!-- Apps by Kai Showcase Section (Easlo Official Style) -->
    <section class="space-y-6 text-center pt-2">
      <!-- Centered Header & Subtitle & View All Button -->
      <div class="space-y-3 flex flex-col items-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 font-sans">
          <span data-lang="en">Apps by Kai</span>
          <span data-lang="zh">Kai 的應用程式</span>
        </h2>
        <p class="text-sm sm:text-base text-zinc-500 dark:text-zinc-400 max-w-md mx-auto leading-relaxed">
          <span data-lang="en">Get things done with apps designed with simplicity in mind.</span>
          <span data-lang="zh">以簡約為本打造，專注提升日常體驗的 Android 應用。</span>
        </p>
        <div class="pt-1">
          <a
            href="/apps"
            class="inline-flex items-center justify-center px-5 py-2 rounded-full bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900 text-xs font-semibold hover:opacity-90 transition-all duration-200 active:scale-95 shadow-xs"
          >
            <span data-lang="en">View All</span>
            <span data-lang="zh">查看全部</span>
          </a>
        </div>
      </div>

      <!-- App Icon Grid / List (Centered, 2 Apps side-by-side) -->
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12 pt-4">
        {
          apps.map((app) => (
            <a
              href={`/apps/${app.slug}`}
              class="group flex flex-col items-center text-center space-y-3 cursor-pointer"
            >
              <!-- Large App Icon Container (140px~160px, rounded-[2.2rem]) -->
              <div class="w-36 h-36 sm:w-40 sm:h-40 rounded-[2.2rem] border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/80 flex items-center justify-center p-6 transition-all duration-300 ease-out group-hover:scale-105 group-hover:-translate-y-1 group-hover:shadow-md group-hover:border-zinc-300 dark:group-hover:border-zinc-700 active:scale-95 shadow-xs">
                <img
                  src={app.icon}
                  alt={`${app.name} icon`}
                  class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl shadow-xs object-contain"
                  loading="lazy"
                />
              </div>

              <!-- Labels Below Icon -->
              <div class="space-y-1">
                <div class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:underline">
                  {app.name}
                </div>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-[160px] leading-relaxed mx-auto">
                  <span data-lang="en">{app.shortTagline.en}</span>
                  <span data-lang="zh">{app.shortTagline.zh}</span>
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Selected Work Preview (Graphic-First Device Mockup Card) -->
    <section class="space-y-4">
      <div class="flex items-center justify-between border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
        <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          <span data-lang="en">Featured &bull; {featuredApp.name} (Dual Styles)</span>
          <span data-lang="zh">精選作品 &bull; {featuredApp.name}（雙風格切換）</span>
        </span>
        <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
          v{featuredApp.version}
        </span>
      </div>

      <!-- Bento Visual Card: Mono Style Mockup + Tech Style Mockup + Capsule Preview -->
      <div class="group rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-6 sm:p-10 transition-all duration-300 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-sm">
        <a href={`/apps/${featuredApp.slug}`} class="block mb-8 hover:opacity-95 transition-opacity">
          <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-center gap-6 md:gap-8 py-2">
            
            <!-- Phone 1: Mono Style (01) -->
            <div class="flex flex-col items-center space-y-2">
              <div class="relative w-full max-w-[220px] sm:max-w-[240px] rounded-[40px] p-2.5 bg-zinc-900 dark:bg-zinc-950 border-[2.5px] border-zinc-300 dark:border-zinc-700 shadow-2xl transition-transform duration-300 hover:-translate-y-1">
                <div class="absolute top-3.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-zinc-800 border border-zinc-700/60 z-20"></div>
                <div class="relative rounded-[30px] overflow-hidden bg-zinc-950 aspect-[472/1024]">
                  <img
                    src="/apps/device-box/mono-main.png"
                    alt="Device Box 黑白風格"
                    class="w-full h-full object-cover"
                    loading="eager"
                  />
                </div>
              </div>
              <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
                <span data-lang="en">Minimal Mono</span>
                <span data-lang="zh">極簡黑白風格</span>
              </span>
            </div>

            <!-- Phone 2: Tech Style (04) -->
            <div class="flex flex-col items-center space-y-2">
              <div class="relative w-full max-w-[220px] sm:max-w-[240px] rounded-[40px] p-2.5 bg-zinc-900 dark:bg-zinc-950 border-[2.5px] border-cyan-700/60 dark:border-cyan-500/40 shadow-2xl transition-transform duration-300 hover:-translate-y-1">
                <div class="absolute top-3.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-zinc-800 border border-zinc-700/60 z-20"></div>
                <div class="relative rounded-[30px] overflow-hidden bg-zinc-950 aspect-[472/1024]">
                  <img
                    src="/apps/device-box/tech-main.png"
                    alt="Device Box 未來科技風格"
                    class="w-full h-full object-cover"
                    loading="eager"
                  />
                </div>
              </div>
              <span class="text-[11px] font-mono text-cyan-600 dark:text-cyan-400">
                <span data-lang="en">Cyber Tech</span>
                <span data-lang="zh">未來科技風格</span>
              </span>
            </div>

            <!-- Side Card: Status Bar Capsule & Widgets Preview -->
            <div class="flex flex-col items-center sm:items-start gap-4 w-full max-w-[260px]">
              <!-- Capsule Card -->
              <div class="w-full rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/80 p-3.5 shadow-lg space-y-2 transition-transform duration-200 hover:-translate-y-0.5">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
                    <span data-lang="en">Status Bar Capsule</span>
                    <span data-lang="zh">狀態列即時膠囊</span>
                  </span>
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                </div>
                <div class="rounded-xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 bg-zinc-950 p-1.5 shadow-xs">
                  <img
                    src="/apps/device-box/preview-capsule.png"
                    alt="狀態列即時膠囊"
                    class="w-full h-auto object-cover rounded-lg"
                    loading="eager"
                  />
                </div>
                <p class="text-[10px] text-zinc-500 dark:text-zinc-400 font-mono leading-tight">
                  <span data-lang="en">Dynamic indicator in status bar</span>
                  <span data-lang="zh">常駐狀態列時鐘旁微型指標</span>
                </p>
              </div>

              <!-- Widgets Card -->
              <div class="w-full rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/80 p-3.5 shadow-lg space-y-2 transition-transform duration-200 hover:-translate-y-0.5">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-mono font-medium text-zinc-500 dark:text-zinc-400 uppercase tracking-wider">
                    <span data-lang="en">Widgets &bull; Home</span>
                    <span data-lang="zh">桌面小工具</span>
                  </span>
                  <span class="text-[10px] font-mono text-zinc-400">
                    <span data-lang="en">Multi-size</span>
                    <span data-lang="zh">多規格</span>
                  </span>
                </div>
                <div class="rounded-xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 bg-zinc-950 p-1.5 shadow-xs">
                  <img
                    src="/apps/device-box/tech-widgets.png"
                    alt="桌面小工具專區"
                    class="w-full h-auto object-contain rounded-lg"
                    loading="eager"
                  />
                </div>
                <p class="text-[10px] text-zinc-500 dark:text-zinc-400 font-mono leading-tight">
                  <span data-lang="en">Samsung arc & Widgy styles</span>
                  <span data-lang="zh">三星環狀儀表與 Widgy 風格</span>
                </p>
              </div>
            </div>

          </div>
        </a>

        <!-- Minimal Info & Action Bar Below Mockup -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-zinc-100 dark:border-zinc-800/60">
          <div class="flex items-center gap-2.5">
            <a
              href={`/apps/${featuredApp.slug}`}
              class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100 hover:underline"
            >
              {featuredApp.name}
            </a>
            <span class="px-2 py-0.5 rounded-full text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
              v{featuredApp.version}
            </span>
            <span class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              <span data-lang="en">Dual Themes</span>
              <span data-lang="zh">雙風格切換</span>
            </span>
          </div>

          <!-- Direct Actions -->
          <div class="flex items-center gap-2.5">
            <a
              href={featuredApp.downloadUrl}
              download
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900 text-xs font-semibold hover:opacity-90 transition-all duration-150 active:scale-[0.97] shadow-xs"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="7 10 12 15 17 10" />
                <line x1="12" y1="15" x2="12" y2="3" />
              </svg>
              <span data-lang="en">Download APK</span>
              <span data-lang="zh">下載 APK</span>
            </a>

            <a
              href={featuredApp.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 text-xs font-medium hover:bg-zinc-100 dark:hover:bg-zinc-800/60 transition-all duration-150 active:scale-[0.97]"
            >
              <svg class="w-3.5 h-3.5 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 大特色圖形化 (Feature Cards: Bento Grid) -->
    <section class="space-y-4">
      <div class="border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
        <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          <span data-lang="en">Highlights</span>
          <span data-lang="zh">核心亮點</span>
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
        <!-- Feature 1: 雙風格切換 -->
        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 flex flex-col items-center justify-center text-center gap-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-300 dark:hover:border-zinc-700">
          <div class="w-11 h-11 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100">
            <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
              <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
              <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
              <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
              <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
            </svg>
          </div>
          <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            <span data-lang="en">Dual Themes</span>
            <span data-lang="zh">雙風格自由切換</span>
          </span>
        </div>

        <!-- Feature 2: 裝置數據 -->
        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 flex flex-col items-center justify-center text-center gap-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-300 dark:hover:border-zinc-700">
          <div class="w-11 h-11 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100">
            <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="16" height="16" x="4" y="4" rx="2" />
              <rect width="6" height="6" x="9" y="9" rx="1" />
              <path d="M15 2v2" /><path d="M15 20v2" /><path d="M2 15h2" /><path d="M2 9h2" /><path d="M20 15h2" /><path d="M20 9h2" /><path d="M9 2v2" /><path d="M9 20v2" />
            </svg>
          </div>
          <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            <span data-lang="en">Device Specs</span>
            <span data-lang="zh">核心硬體規格監控</span>
          </span>
        </div>

        <!-- Feature 3: 測速與加速 -->
        <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 flex flex-col items-center justify-center text-center gap-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-zinc-300 dark:hover:border-zinc-700">
          <div class="w-11 h-11 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-zinc-100">
            <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
            </svg>
          </div>
          <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            <span data-lang="en">Fast &amp; Private</span>
            <span data-lang="zh">記憶體加速與測速</span>
          </span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
