---
// apps/[slug].astro - Easlo Visual Overhaul
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeviceMockup from '../../components/DeviceMockup.astro';
import { apps, type App } from '../../data/apps';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app }
  }));
}

interface Props {
  app: App;
}

const { app } = Astro.props;

const featureCards = [
  {
    title: '裝置數據',
    subtitle: '即時讀取核心硬體規格',
    icon: 'cpu'
  },
  {
    title: '簡約美學',
    subtitle: 'Compose 原生純粹視覺',
    icon: 'layout'
  },
  {
    title: '輕量好用',
    subtitle: '秒速開啟零多餘負擔',
    icon: 'zap'
  },
  {
    title: '隱私至上',
    subtitle: '無廣告無追蹤完全本機',
    icon: 'shield'
  }
];
---

<BaseLayout
  title={`${app.name} — Kai Liu`}
  description={app.tagline}
  image={app.icon}
>
  <div class="space-y-12 sm:space-y-16 py-2">
    <!-- Top Bar: Back link -->
    <div>
      <a
        href="/apps"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors group"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
        <span>Back to Apps</span>
      </a>
    </div>

    <!-- App Header: Large Icon + Name + Version -->
    <header class="flex flex-col items-center text-center space-y-4">
      <img
        src={app.icon}
        alt={`${app.name} Icon`}
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl shadow-sm border border-zinc-200 dark:border-zinc-800"
      />

      <div class="space-y-1.5">
        <div class="flex items-center justify-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            {app.name}
          </h1>
          <span class="px-2 py-0.5 rounded-full text-xs font-mono font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
            v{app.version}
          </span>
        </div>
        <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400 max-w-md">
          {app.tagline}
        </p>
      </div>

      <!-- Action Buttons (High contrast clean buttons) -->
      <div class="flex items-center gap-3 pt-2">
        <a
          href={app.downloadUrl}
          download
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900 text-xs sm:text-sm font-semibold hover:opacity-90 transition-opacity shadow-sm"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span>Download APK</span>
        </a>

        <a
          href={app.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-medium hover:bg-zinc-100 dark:hover:bg-zinc-800/60 transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <!-- Core Visual Showcase: Phone Mockup (Image 2) + Floating Widget (Image 1) -->
    {app.screenshots && app.screenshots.length > 0 ? (
      <div class="space-y-10">
        <!-- 1. Interface & Widget Preview Showcase -->
        <section class="space-y-4">
          <div class="flex items-center justify-between border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
              Interface Preview
            </span>
            <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
              Android 16 &bull; Jetpack Compose
            </span>
          </div>

          <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-6 sm:p-12">
            <div class="max-w-3xl mx-auto flex flex-col md:flex-row items-center justify-center gap-8 md:gap-12">
              
              <!-- 1. Real Phone Frame (Image 2 - Main Screen, First) -->
              <div class="flex flex-col items-center space-y-3 shrink-0">
                <div class="relative w-full max-w-[270px] sm:max-w-[290px] rounded-[44px] p-2.5 sm:p-3 bg-zinc-900 dark:bg-zinc-950 border-[3px] border-zinc-300 dark:border-zinc-700 shadow-2xl transition-transform hover:-translate-y-1 duration-200">
                  <!-- Punch Hole Camera -->
                  <div class="absolute top-4 left-1/2 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-zinc-800 border border-zinc-700/60 z-20"></div>
                  <!-- Screen Container with Image 2 -->
                  <div class="relative rounded-[34px] overflow-hidden bg-zinc-950 aspect-[472/1024]">
                    <img
                      src={app.screenshots[0]}
                      alt="Device Box 主介面 (圖2)"
                      class="w-full h-full object-cover"
                      loading="eager"
                    />
                  </div>
                </div>
                <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  主介面 &bull; 規格與模式開關
                </span>
              </div>

              <!-- 2. Widgets Column (Image 1 Floating Widget + Status Bar Capsule) -->
              <div class="flex flex-col gap-5 w-full max-w-sm">
                
                <!-- Widget Card: Floating Monitor (Image 1) -->
                {app.screenshots[1] && (
                  <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 p-5 space-y-3 shadow-sm hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                        桌面即時懸浮儀表
                      </span>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                        Floating
                      </span>
                    </div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                      自由拖曳懸浮窗，即時監控溫度、CPU、電量與下載網速
                    </p>
                    <div class="rounded-xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 bg-zinc-950 p-2.5 flex items-center justify-center">
                      <img
                        src={app.screenshots[1]}
                        alt="桌面懸浮視窗儀表 (圖1)"
                        class="w-full max-w-[280px] h-auto object-contain rounded-lg"
                        loading="eager"
                      />
                    </div>
                  </div>
                )}

                <!-- Widget Card: Status Bar Capsule -->
                {app.screenshots[2] && (
                  <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/60 p-5 space-y-3 shadow-sm hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
                    <div class="flex items-center justify-between">
                      <span class="text-xs font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                        狀態列即時膠囊
                      </span>
                      <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-zinc-200/80 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                        Capsule
                      </span>
                    </div>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                      常駐 Android 狀態列，無需切換 App 隨時掌握晶片資訊
                    </p>
                    <div class="rounded-xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 bg-zinc-950">
                      <img
                        src={app.screenshots[2]}
                        alt="狀態列即時膠囊"
                        class="w-full h-auto object-cover"
                        loading="eager"
                      />
                    </div>
                  </div>
                )}

              </div>

            </div>
          </div>
        </section>
      </div>
    ) : (
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
            Mockup Preview
          </span>
          <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
            Jetpack Compose
          </span>
        </div>

        <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-6 sm:p-12">
          <DeviceMockup />
        </div>
      </section>
    )}

    <!-- Feature Grid: 2x2 Bento Visual Cards -->
    <section class="space-y-4">
      <div class="border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
        <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          Features
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {featureCards.map((card) => (
          <div class="p-4 sm:p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 flex items-center gap-4 transition-all hover:border-zinc-300 dark:hover:border-zinc-700">
            <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center shrink-0 text-zinc-900 dark:text-zinc-100">
              {card.icon === 'cpu' && (
                <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="16" height="16" x="4" y="4" rx="2" />
                  <rect width="6" height="6" x="9" y="9" rx="1" />
                  <path d="M15 2v2" /><path d="M15 20v2" /><path d="M2 15h2" /><path d="M2 9h2" /><path d="M20 15h2" /><path d="M20 9h2" /><path d="M9 2v2" /><path d="M9 20v2" />
                </svg>
              )}
              {card.icon === 'layout' && (
                <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect width="18" height="18" x="3" y="3" rx="2" />
                  <path d="M3 9h18" /><path d="M9 21V9" />
                </svg>
              )}
              {card.icon === 'zap' && (
                <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                </svg>
              )}
              {card.icon === 'shield' && (
                <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                </svg>
              )}
            </div>

            <div class="space-y-0.5">
              <div class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                {card.title}
              </div>
              <div class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                {card.subtitle}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Tech Stack (Minimalist Chips) -->
    <section class="space-y-3 pt-2">
      <div class="border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
        <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          Stack
        </span>
      </div>
      <div class="flex flex-wrap gap-2">
        {app.technologies.map((tech) => (
          <span class="px-2.5 py-1 rounded-lg text-xs font-mono border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 text-zinc-600 dark:text-zinc-400">
            {tech}
          </span>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
