---
// apps/[slug].astro - Dynamic Showcase for Device Box and FocusNow with Bilingual i18n
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apps, type App } from '../../data/apps';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app }
  }));
}

interface Props {
  app: App;
}

const { app } = Astro.props;
const isDeviceBox = app.slug === 'device-box';
const isFocusNow = app.slug === 'focus-now';
---

<BaseLayout
  title={`${app.name} — Kai Liu`}
  description={app.tagline.en}
  image={app.icon}
>
  <div class="space-y-14 sm:space-y-20 py-2">
    <!-- Top Bar: Back link -->
    <div>
      <a
        href="/apps"
        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors group"
      >
        <span class="transition-transform group-hover:-translate-x-1">&larr;</span>
        <span data-lang="en">Back to Apps</span>
        <span data-lang="zh">返回應用列表</span>
      </a>
    </div>

    <!-- App Header: Large Icon + Name + Version + Badge -->
    <header class="flex flex-col items-center text-center space-y-4">
      <img
        src={app.icon}
        alt={`${app.name} Icon`}
        class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl shadow-sm border border-zinc-200 dark:border-zinc-800 object-contain transition-transform hover:scale-105 duration-200"
      />

      <div class="space-y-2">
        <div class="flex flex-wrap items-center justify-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            {app.name}
          </h1>
          <span class="px-2 py-0.5 rounded-full text-xs font-mono font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
            v{app.version}
          </span>
          {isDeviceBox && (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-medium border border-emerald-500/30 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
              <span data-lang="en">Dual Themes</span>
              <span data-lang="zh">支援雙風格切換</span>
            </span>
          )}
          {isFocusNow && (
            <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-medium border border-zinc-300 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200">
              <span data-lang="en">Digital Detox</span>
              <span data-lang="zh">數位排毒 &bull; 專注當下</span>
            </span>
          )}
        </div>
        <p class="text-sm font-medium text-zinc-500 dark:text-zinc-400 max-w-lg leading-relaxed">
          <span data-lang="en">{app.tagline.en}</span>
          <span data-lang="zh">{app.tagline.zh}</span>
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3 pt-2">
        <a
          href={app.downloadUrl}
          download
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-900 text-xs sm:text-sm font-semibold hover:opacity-90 active:scale-[0.97] transition-all shadow-sm"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          <span data-lang="en">Download APK</span>
          <span data-lang="zh">下載 APK</span>
        </a>

        <a
          href={app.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-medium hover:bg-zinc-100 dark:hover:bg-zinc-800/60 active:scale-[0.97] transition-all"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
            <path d="M9 18c-4.51 2-5-2-7-2" />
          </svg>
          <span>GitHub</span>
        </a>
      </div>
    </header>

    <!-- ============================================================ -->
    <!-- DEVICE BOX 專屬三大區塊 -->
    <!-- ============================================================ -->
    {isDeviceBox && (
      <>
        <!-- 第一部分：黑白風格 (圖 1, 圖 2, 圖 3) -->
        <section class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
                Part 1 &bull; Minimalist Monochrome
              </span>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">
                <span data-lang="en">Minimalist Mono Style</span>
                <span data-lang="zh">極簡黑白風格</span>
              </h2>
            </div>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 max-w-sm">
              <span data-lang="en">Pure high-contrast monochrome design, eliminating noise to focus on raw hardware metrics.</span>
              <span data-lang="zh">回歸純粹的黑白明暗對比，消除多餘雜訊，專注硬體數據呈現。</span>
            </p>
          </div>

          <!-- 3-Column Phone Showcase for Mono Style -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            {app.monoScreenshots?.map((item) => (
              <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-5 sm:p-6 flex flex-col items-center text-center space-y-4 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
                <!-- Phone Frame -->
                <div class="relative w-full max-w-[240px] sm:max-w-[260px] rounded-[38px] p-2.5 bg-zinc-900 dark:bg-zinc-950 border-[2.5px] border-zinc-300 dark:border-zinc-700 shadow-xl transition-transform hover:-translate-y-1 duration-200">
                  <div class="absolute top-3.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-zinc-800 border border-zinc-700/60 z-20"></div>
                  <div class="relative rounded-[28px] overflow-hidden bg-zinc-950 aspect-[472/1024]">
                    {typeof item.image === 'string' ? (
                      <img
                        src={item.image}
                        alt={item.title.en}
                        class="w-full h-full object-cover"
                        loading="eager"
                      />
                    ) : (
                      <>
                        <img
                          src={item.image.en}
                          alt={item.title.en}
                          class="w-full h-full object-cover"
                          data-lang="en"
                          loading="eager"
                        />
                        <img
                          src={item.image.zh}
                          alt={item.title.zh}
                          class="w-full h-full object-cover"
                          data-lang="zh"
                          loading="eager"
                        />
                      </>
                    )}
                  </div>
                </div>

                <!-- Card Intro -->
                <div class="space-y-1.5 pt-1">
                  <span class="inline-block text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
                    <span data-lang="en">{item.subtitle.en}</span>
                    <span data-lang="zh">{item.subtitle.zh}</span>
                  </span>
                  <h3 class="text-base font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                    <span data-lang="en">{item.title.en}</span>
                    <span data-lang="zh">{item.title.zh}</span>
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed font-sans px-1">
                    <span data-lang="en">{item.description.en}</span>
                    <span data-lang="zh">{item.description.zh}</span>
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 第二部分：科技風格 (圖 4, 圖 5, 圖 6) -->
        <section class="space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-cyan-600 dark:text-cyan-400">
                Part 2 &bull; Cyberpunk Neon Tech
              </span>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">
                <span data-lang="en">Cyber Tech Style</span>
                <span data-lang="zh">未來科技風格</span>
              </h2>
            </div>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 max-w-sm">
              <span data-lang="en">High-contrast neon cyan and live waveform graphs designed for tech geeks.</span>
              <span data-lang="zh">高對比霓虹青藍與動態折線圖，打造極客專屬的沉浸式監控視覺。</span>
            </p>
          </div>

          <!-- 3-Column Phone Showcase for Tech Style -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            {app.techScreenshots?.map((item) => (
              <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-5 sm:p-6 flex flex-col items-center text-center space-y-4 hover:border-cyan-500/40 dark:hover:border-cyan-500/30 transition-all">
                <div class="relative w-full max-w-[240px] sm:max-w-[260px] rounded-[38px] p-2.5 bg-zinc-900 dark:bg-zinc-950 border-[2.5px] border-zinc-300 dark:border-zinc-700 shadow-xl transition-transform hover:-translate-y-1 duration-200">
                  <div class="absolute top-3.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-zinc-800 border border-zinc-700/60 z-20"></div>
                  <div class="relative rounded-[28px] overflow-hidden bg-zinc-950 aspect-[472/1024]">
                    {typeof item.image === 'string' ? (
                      <img
                        src={item.image}
                        alt={item.title.en}
                        class="w-full h-full object-cover"
                        loading="eager"
                      />
                    ) : (
                      <>
                        <img
                          src={item.image.en}
                          alt={item.title.en}
                          class="w-full h-full object-cover"
                          data-lang="en"
                          loading="eager"
                        />
                        <img
                          src={item.image.zh}
                          alt={item.title.zh}
                          class="w-full h-full object-cover"
                          data-lang="zh"
                          loading="eager"
                        />
                      </>
                    )}
                  </div>
                </div>

                <div class="space-y-1.5 pt-1">
                  <span class="inline-block text-[11px] font-mono text-cyan-600 dark:text-cyan-400 font-medium">
                    <span data-lang="en">{item.subtitle.en}</span>
                    <span data-lang="zh">{item.subtitle.zh}</span>
                  </span>
                  <h3 class="text-base font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                    <span data-lang="en">{item.title.en}</span>
                    <span data-lang="zh">{item.title.zh}</span>
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed font-sans px-1">
                    <span data-lang="en">{item.description.en}</span>
                    <span data-lang="zh">{item.description.zh}</span>
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- 第三部分：狀態列即時膠囊 (放最下面) -->
        {app.capsuleScreenshot && (
          <section class="space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3">
              <div>
                <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
                  Part 3 &bull; Status Bar Capsule
                </span>
                <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">
                  <span data-lang="en">Status Bar Capsule</span>
                  <span data-lang="zh">狀態列即時膠囊</span>
                </h2>
              </div>
              <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 max-w-sm">
                <span data-lang="en">Always resident next to the status bar clock, keeping crucial stats in view.</span>
                <span data-lang="zh">常駐 Android 狀態列時鐘旁，微型指標預覽，無需切換 App。</span>
              </p>
            </div>

            <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-6 sm:p-10 flex flex-col lg:flex-row items-center justify-between gap-8 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
              <div class="space-y-3 max-w-md">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span>Always-On Dynamic Capsule</span>
                </div>
                <h3 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                  <span data-lang="en">Status Bar Micro Indicator</span>
                  <span data-lang="zh">狀態列即時微型指標</span>
                </h3>
                <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
                  <span data-lang="en">A system-level micro indicator that lives beside your clock. Whether gaming, watching movies, or browsing, key system frequencies and loads are accessible without interruption.</span>
                  <span data-lang="zh">透過系統級微型膠囊服務，常駐於頂部狀態列時鐘旁。無論是在遊戲、追劇或瀏覽網頁時，晶片運作頻率與核心規格一目了然，並提供通知欄下拉完整規格展開面板。</span>
                </p>
              </div>

              <div class="w-full max-w-xl rounded-2xl overflow-hidden border border-zinc-200/80 dark:border-zinc-800 bg-zinc-950 p-2 sm:p-3 shadow-lg">
                <img
                  src={app.capsuleScreenshot}
                  alt="狀態列即時膠囊"
                  class="w-full h-auto object-cover rounded-xl"
                  loading="lazy"
                />
              </div>
            </div>
          </section>
        )}
      </>
    )}

    <!-- ============================================================ -->
    <!-- FOCUSNOW 專屬展示區塊 (Flip to Focus & App Blocker Showcase) -->
    <!-- ============================================================ -->
    {isFocusNow && (
      <section class="space-y-8">
        <!-- Hero Deep Work Graphic Card -->
        <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/40 p-8 sm:p-12 flex flex-col items-center justify-center text-center space-y-6">
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-3xl overflow-hidden border border-zinc-200 dark:border-zinc-700 bg-black flex items-center justify-center shadow-lg transition-transform hover:scale-105 duration-300">
            <img
              src="/apps/focus-now-icon.png"
              alt="FocusNow Logo"
              class="w-full h-full object-cover"
            />
          </div>

          <div class="space-y-2 max-w-md">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 font-sans">
              <span data-lang="en">Flip Phone Face-Down. Enter Deep Work.</span>
              <span data-lang="zh">手機朝下蓋住，立即進入深度專注。</span>
            </h2>
            <p class="text-sm text-zinc-500 dark:text-zinc-400 leading-relaxed">
              <span data-lang="en">{app.description.en}</span>
              <span data-lang="zh">{app.description.zh}</span>
            </p>
          </div>

          <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <span class="px-3.5 py-1.5 rounded-full text-xs font-mono border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300">
              <span data-lang="en">SensorManager Gesture</span>
              <span data-lang="zh">重力感應翻轉識別</span>
            </span>
            <span class="px-3.5 py-1.5 rounded-full text-xs font-mono border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300">
              <span data-lang="en">Accessibility App Blocker</span>
              <span data-lang="zh">無干擾應用鎖定</span>
            </span>
            <span class="px-3.5 py-1.5 rounded-full text-xs font-mono border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300">
              <span data-lang="en">100% Offline &amp; Private</span>
              <span data-lang="zh">純本地離線隱私保護</span>
            </span>
          </div>
        </div>

        <!-- 4 Core Feature Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {app.featureCards?.map((card) => (
            <div class="p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 flex items-start gap-4 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
              <div class="w-11 h-11 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center shrink-0 text-zinc-900 dark:text-zinc-100">
                {card.icon === 'lock' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                )}
                {card.icon === 'smartphone' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="14" height="20" x="5" y="2" rx="2" ry="2" />
                    <path d="M12 18h.01" />
                  </svg>
                )}
                {card.icon === 'sparkles' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z" />
                  </svg>
                )}
                {card.icon === 'bar-chart' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" x2="12" y1="20" y2="10" />
                    <line x1="18" x2="18" y1="20" y2="4" />
                    <line x1="6" x2="6" y1="20" y2="16" />
                  </svg>
                )}
              </div>

              <div class="space-y-1">
                <h3 class="text-base font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                  <span data-lang="en">{card.title.en}</span>
                  <span data-lang="zh">{card.title.zh}</span>
                </h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed font-sans">
                  <span data-lang="en">{card.subtitle.en}</span>
                  <span data-lang="zh">{card.subtitle.zh}</span>
                </p>
              </div>
            </div>
          ))}
        </div>

        <!-- FocusNow 4-Column Phone Mockup Showcase with Dynamic Bilingual Switching -->
        <div class="space-y-6 pt-4">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-3">
            <div>
              <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
                Interface Tour &bull; Deep Work Flow
              </span>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1">
                <span data-lang="en">App Interface Tour</span>
                <span data-lang="zh">應用介面導覽與特色</span>
              </h2>
            </div>
            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 max-w-sm">
              <span data-lang="en">Minimalist monochrome design crafted to eliminate distractions and cultivate digital discipline.</span>
              <span data-lang="zh">純黑白極簡克制設計，從倒數計時到阻擋防護，全方位培養數位專注自律。</span>
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-5">
            {app.focusScreenshots?.map((item) => (
              <div class="rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 p-4 sm:p-5 flex flex-col items-center text-center space-y-4 hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
                <!-- Phone Frame Mockup -->
                <div class="relative w-full max-w-[190px] sm:max-w-[210px] rounded-[34px] p-2 bg-zinc-900 dark:bg-zinc-950 border-[2.5px] border-zinc-300 dark:border-zinc-700 shadow-xl transition-transform hover:-translate-y-1 duration-200">
                  <div class="absolute top-3 left-1/2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-zinc-800 border border-zinc-700/60 z-20"></div>
                  <div class="relative rounded-[26px] overflow-hidden bg-zinc-950 aspect-[1440/3120]">
                    {typeof item.image === 'string' ? (
                      <img
                        src={item.image}
                        alt={item.title.en}
                        class="w-full h-full object-cover"
                        loading="eager"
                      />
                    ) : (
                      <>
                        <img
                          src={item.image.en}
                          alt={item.title.en}
                          class="w-full h-full object-cover"
                          data-lang="en"
                          loading="eager"
                        />
                        <img
                          src={item.image.zh}
                          alt={item.title.zh}
                          class="w-full h-full object-cover"
                          data-lang="zh"
                          loading="eager"
                        />
                      </>
                    )}
                  </div>
                </div>

                <!-- Text Intro -->
                <div class="space-y-1.5 pt-1 w-full text-left">
                  <span class="inline-block text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
                    <span data-lang="en">{item.subtitle.en}</span>
                    <span data-lang="zh">{item.subtitle.zh}</span>
                  </span>
                  <h3 class="text-sm sm:text-base font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                    <span data-lang="en">{item.title.en}</span>
                    <span data-lang="zh">{item.title.zh}</span>
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed font-sans">
                    <span data-lang="en">{item.description.en}</span>
                    <span data-lang="zh">{item.description.zh}</span>
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Highlights Features List -->
    {isDeviceBox && (
      <section class="space-y-4 pt-2">
        <div class="border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
            <span data-lang="en">Highlights</span>
            <span data-lang="zh">特色總覽</span>
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {app.featureCards?.map((card) => (
            <div class="p-4 sm:p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/30 flex items-center gap-4 transition-all hover:border-zinc-300 dark:hover:border-zinc-700">
              <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center shrink-0 text-zinc-900 dark:text-zinc-100">
                {card.icon === 'palette' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" />
                    <circle cx="17.5" cy="10.5" r=".5" fill="currentColor" />
                    <circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />
                    <circle cx="6.5" cy="12.5" r=".5" fill="currentColor" />
                    <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
                  </svg>
                )}
                {card.icon === 'cpu' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="16" height="16" x="4" y="4" rx="2" />
                    <rect width="6" height="6" x="9" y="9" rx="1" />
                    <path d="M15 2v2" /><path d="M15 20v2" /><path d="M2 15h2" /><path d="M2 9h2" /><path d="M20 15h2" /><path d="M20 9h2" /><path d="M9 2v2" /><path d="M9 20v2" />
                  </svg>
                )}
                {card.icon === 'zap' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                )}
                {card.icon === 'shield' && (
                  <svg class="w-5 h-5 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
                  </svg>
                )}
              </div>

              <div class="space-y-0.5">
                <div class="text-sm font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
                  <span data-lang="en">{card.title.en}</span>
                  <span data-lang="zh">{card.title.zh}</span>
                </div>
                <div class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
                  <span data-lang="en">{card.subtitle.en}</span>
                  <span data-lang="zh">{card.subtitle.zh}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Tech Stack (Minimalist Chips) -->
    <section class="space-y-3 pt-2">
      <div class="border-b border-zinc-200/70 dark:border-zinc-800/80 pb-2">
        <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          <span data-lang="en">Technologies</span>
          <span data-lang="zh">使用技術</span>
        </span>
      </div>
      <div class="flex flex-wrap gap-2">
        {app.technologies.map((tech) => (
          <span class="px-2.5 py-1 rounded-lg text-xs font-mono border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/40 text-zinc-600 dark:text-zinc-400">
            {tech}
          </span>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
