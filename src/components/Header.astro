---
// Header.astro - Easlo-style Header with Avatar, Language Toggle & Liquid Glass Mobile Menu
// Header.astro - Minimalist Header with Avatar, Language Toggle & Liquid Glass Mobile Menu
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.astro';

const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, '');

const navLinks = [
  { href: '/apps', label: { en: 'Apps', zh: '應用' }, isExternal: false },
  { href: '/about', label: { en: 'About', zh: '關於' }, isExternal: false },
  { href: 'https://github.com/binno894894-dotcom', label: { en: 'GitHub', zh: 'GitHub' }, isExternal: true },
  { href: 'https://www.threads.com/@stu6yen9ineer', label: { en: 'Threads', zh: 'Threads' }, isExternal: true },
];
---

<header class="w-full pt-6 sm:pt-8 pb-5 sm:pb-6 border-b border-zinc-100 dark:border-zinc-900/90 mb-8 sm:mb-12 relative z-50">
  <div class="flex items-center justify-between">
    <!-- Brand / Name with Avatar -->
    <a
      href="/"
      class="group inline-flex items-center gap-3 text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 transition-all duration-200 active:scale-95 select-none"
    >
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800 shrink-0 transition-transform duration-300 group-hover:scale-105 shadow-xs">
        <img
          src="/avatar.png"
          alt="Kai Liu Avatar"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <span class="transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300">Kai Liu</span>
    </a>

    <!-- Desktop Navigation (md:flex) -->
    <nav class="hidden md:flex items-center gap-2">
      <div class="flex items-center gap-1 text-sm font-medium">
        {
          navLinks.map((link) => {
            const isActive = !link.isExternal && (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)));
            return (
              <a
                href={link.href}
                target={link.isExternal ? '_blank' : undefined}
                rel={link.isExternal ? 'noopener noreferrer' : undefined}
                class:list={[
                  'inline-flex items-center gap-1 px-3 py-1.5 rounded-lg transition-all duration-150 active:scale-95 select-none',
                  isActive
                    ? 'text-zinc-900 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-800/80 font-semibold'
                    : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-800/40'
                ]}
              >
                <span data-lang="en">{link.label.en}</span>
                <span data-lang="zh">{link.label.zh}</span>
                {link.isExternal && (
                  <svg
                    class="w-3 h-3 opacity-60 stroke-current"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                )}
              </a>
            );
          })
        }
      </div>

      <div class="ml-2 pl-2 border-l border-zinc-200 dark:border-zinc-800 flex items-center gap-1.5">
        <LanguageToggle />
        <ThemeToggle />
      </div>
    </nav>

    <!-- Mobile Navigation Controls (md:hidden) -->
    <div class="flex md:hidden items-center gap-1.5">
      <LanguageToggle />
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Toggle Menu"
        aria-expanded="false"
        class="w-9 h-9 rounded-xl border border-zinc-200/80 dark:border-zinc-700/60 bg-white/60 dark:bg-zinc-800/60 backdrop-blur-md flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:bg-white/90 dark:hover:bg-zinc-700/70 transition-all duration-150 active:scale-90 shadow-2xs cursor-pointer select-none"
      >
        <!-- Icon: Hamburger (3 lines) -->
        <svg id="icon-menu" class="w-4 h-4 stroke-current transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <!-- Icon: Close ✕ (Hidden initially) -->
        <svg id="icon-close" class="w-4 h-4 stroke-current hidden transition-transform duration-300 rotate-90" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div
    id="mobile-menu-backdrop"
    class="fixed inset-0 bg-black/15 dark:bg-black/35 backdrop-blur-[2px] z-40 hidden transition-opacity duration-300 opacity-0 md:hidden"
  ></div>

  <!-- Mobile Liquid Glass Menu Panel -->
  <div
    id="mobile-menu-panel"
    class="fixed inset-x-4 top-20 z-50 rounded-[28px] glass-liquid-panel p-5 sm:p-6 hidden transition-all duration-300 -translate-y-3 opacity-0 md:hidden overflow-hidden"
  >
    <!-- Liquid top reflection highlight -->
    <div class="absolute -top-px inset-x-10 h-px bg-gradient-to-r from-transparent via-white/70 dark:via-white/35 to-transparent pointer-events-none"></div>

    <div class="relative z-10 flex flex-col items-center space-y-2 text-center">
      {
        navLinks.map((link) => {
          const isActive = !link.isExternal && (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)));
          return (
            <a
              href={link.href}
              target={link.isExternal ? '_blank' : undefined}
              rel={link.isExternal ? 'noopener noreferrer' : undefined}
              class:list={[
                'w-full py-3 px-4 rounded-2xl text-sm font-medium transition-all duration-150 flex items-center justify-center gap-1.5 active:scale-98 select-none',
                isActive
                  ? 'text-zinc-950 dark:text-white bg-white/70 dark:bg-white/15 font-semibold shadow-xs'
                  : 'text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white hover:bg-white/40 dark:hover:bg-white/10'
              ]}
            >
              <span data-lang="en">{link.label.en}</span>
              <span data-lang="zh">{link.label.zh}</span>
              {link.isExternal && (
                <svg
                  class="w-3.5 h-3.5 opacity-60 stroke-current"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              )}
            </a>
          );
        })
      }

      <!-- Mobile Controls Row: Language & Theme -->
      <div class="w-full pt-3 mt-1 border-t border-zinc-200/50 dark:border-white/10 flex items-center justify-between px-2">
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400" data-lang="en">Language</span>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400" data-lang="zh">語言切換</span>
        <LanguageToggle />
      </div>

      <div class="w-full pt-1.5 flex items-center justify-between px-2">
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400" data-lang="en">Appearance</span>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400" data-lang="zh">外觀模式</span>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-button');
    const panel = document.getElementById('mobile-menu-panel');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (!btn || !panel || !backdrop || !iconMenu || !iconClose) return;

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      btn?.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      setTimeout(() => iconClose?.classList.remove('rotate-90'), 10);

      backdrop?.classList.remove('hidden');
      panel?.classList.remove('hidden');
      
      requestAnimationFrame(() => {
        backdrop?.classList.remove('opacity-0');
        backdrop?.classList.add('opacity-100');
        panel?.classList.remove('-translate-y-3', 'opacity-0');
        panel?.classList.add('translate-y-0', 'opacity-100');
      });
    }

    function closeMenu() {
      isOpen = false;
      btn?.setAttribute('aria-expanded', 'false');
      iconClose?.classList.add('rotate-90');
      setTimeout(() => {
        iconClose?.classList.add('hidden');
        iconMenu?.classList.remove('hidden');
      }, 150);

      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0');
      panel?.classList.remove('translate-y-0', 'opacity-100');
      panel?.classList.add('-translate-y-3', 'opacity-0');

      setTimeout(() => {
        if (!isOpen) {
          backdrop?.classList.add('hidden');
          panel?.classList.add('hidden');
        }
      }, 300);
    }

    btn.onclick = (e) => {
      e.stopPropagation();
      if (isOpen) closeMenu();
      else openMenu();
    };

    backdrop.onclick = (e) => {
      e.stopPropagation();
      closeMenu();
    };

    // Close when clicking any navigation link inside panel
    panel.querySelectorAll('a').forEach((link) => {
      link.onclick = () => closeMenu();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeMenu();
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
