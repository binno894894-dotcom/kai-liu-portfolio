---
// Header.astro - Easlo-style Header with Avatar & Frosted Mobile Menu
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, '');

const navLinks = [
  { href: '/apps', label: 'Apps', isExternal: false },
  { href: '/about', label: 'About', isExternal: false },
  { href: 'https://github.com/binno894894-dotcom', label: 'GitHub', isExternal: true },
  { href: 'https://www.threads.com/@stu6yen9ineer', label: 'Threads', isExternal: true },
];
---

<header class="w-full pt-6 sm:pt-8 pb-5 sm:pb-6 border-b border-zinc-100 dark:border-zinc-900/90 mb-8 sm:mb-12 relative z-50">
  <div class="flex items-center justify-between">
    <!-- Brand / Name with Avatar -->
    <a
      href="/"
      class="group inline-flex items-center gap-3 text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 transition-all duration-200 active:scale-95 select-none"
    >
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-full overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-800 shrink-0 transition-transform duration-300 group-hover:scale-105 shadow-xs">
        <img
          src="/avatar.png"
          alt="Kai Liu Avatar"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
      <span class="transition-colors group-hover:text-zinc-600 dark:group-hover:text-zinc-300">Kai Liu</span>
    </a>

    <!-- Desktop Navigation (md:flex) -->
    <nav class="hidden md:flex items-center gap-2">
      <div class="flex items-center gap-1 text-sm font-medium">
        {
          navLinks.map((link) => {
            const isActive = !link.isExternal && (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)));
            return (
              <a
                href={link.href}
                target={link.isExternal ? '_blank' : undefined}
                rel={link.isExternal ? 'noopener noreferrer' : undefined}
                class:list={[
                  'inline-flex items-center gap-1 px-3 py-1.5 rounded-lg transition-all duration-150 active:scale-95',
                  isActive
                    ? 'text-zinc-900 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-800/80 font-semibold'
                    : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-800/40'
                ]}
              >
                <span>{link.label}</span>
                {link.isExternal && (
                  <svg
                    class="w-3 h-3 opacity-60 stroke-current"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                )}
              </a>
            );
          })
        }
      </div>

      <div class="ml-2 pl-2 border-l border-zinc-200 dark:border-zinc-800">
        <ThemeToggle />
      </div>
    </nav>

    <!-- Mobile Hamburger Button (md:hidden) -->
    <div class="flex md:hidden items-center gap-2">
      <ThemeToggle />
      <button
        id="mobile-menu-button"
        type="button"
        aria-label="Toggle Menu"
        aria-expanded="false"
        class="w-9 h-9 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 flex items-center justify-center text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-all duration-200 active:scale-95"
      >
        <!-- Icon: Hamburger -->
        <svg id="icon-menu" class="w-4 h-4 stroke-current transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
        <!-- Icon: Close (Hidden initially) -->
        <svg id="icon-close" class="w-4 h-4 stroke-current hidden transition-transform duration-300 rotate-90" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div
    id="mobile-menu-backdrop"
    class="fixed inset-0 bg-black/25 dark:bg-black/50 backdrop-blur-xs z-40 hidden transition-opacity duration-300 opacity-0 md:hidden"
  ></div>

  <!-- Mobile Frosted Glass Menu Panel -->
  <div
    id="mobile-menu-panel"
    class="fixed inset-x-4 top-20 z-50 rounded-3xl border border-zinc-200/90 dark:border-zinc-800/90 bg-white/90 dark:bg-zinc-950/90 backdrop-blur-2xl shadow-2xl p-6 hidden transition-all duration-300 -translate-y-4 opacity-0 md:hidden"
  >
    <div class="flex flex-col items-center space-y-4 text-center">
      {
        navLinks.map((link) => {
          const isActive = !link.isExternal && (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)));
          return (
            <a
              href={link.href}
              target={link.isExternal ? '_blank' : undefined}
              rel={link.isExternal ? 'noopener noreferrer' : undefined}
              class:list={[
                'w-full py-2.5 rounded-xl text-sm font-medium transition-all duration-150 flex items-center justify-center gap-1.5 active:scale-98',
                isActive
                  ? 'text-zinc-900 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-900 font-semibold'
                  : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-900/60'
              ]}
            >
              <span>{link.label}</span>
              {link.isExternal && (
                <svg
                  class="w-3.5 h-3.5 opacity-60 stroke-current"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              )}
            </a>
          );
        })
      }

      <div class="w-full pt-2 border-t border-zinc-100 dark:border-zinc-800/80 flex items-center justify-center gap-2">
        <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">Kai Liu &bull; Minimal Studio</span>
      </div>
    </div>
  </div>
</header>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-button');
    const panel = document.getElementById('mobile-menu-panel');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (!btn || !panel || !backdrop || !iconMenu || !iconClose) return;

    let isOpen = false;

    function openMenu() {
      isOpen = true;
      btn?.setAttribute('aria-expanded', 'true');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      setTimeout(() => iconClose?.classList.remove('rotate-90'), 10);

      backdrop?.classList.remove('hidden');
      panel?.classList.remove('hidden');
      
      requestAnimationFrame(() => {
        backdrop?.classList.remove('opacity-0');
        backdrop?.classList.add('opacity-100');
        panel?.classList.remove('-translate-y-4', 'opacity-0');
        panel?.classList.add('translate-y-0', 'opacity-100');
      });
    }

    function closeMenu() {
      isOpen = false;
      btn?.setAttribute('aria-expanded', 'false');
      iconClose?.classList.add('rotate-90');
      setTimeout(() => {
        iconClose?.classList.add('hidden');
        iconMenu?.classList.remove('hidden');
      }, 150);

      backdrop?.classList.remove('opacity-100');
      backdrop?.classList.add('opacity-0');
      panel?.classList.remove('translate-y-0', 'opacity-100');
      panel?.classList.add('-translate-y-4', 'opacity-0');

      setTimeout(() => {
        if (!isOpen) {
          backdrop?.classList.add('hidden');
          panel?.classList.add('hidden');
        }
      }, 300);
    }

    btn.onclick = () => {
      if (isOpen) closeMenu();
      else openMenu();
    };

    backdrop.onclick = closeMenu;

    // Close when clicking any link inside panel
    panel.querySelectorAll('a').forEach((link) => {
      link.onclick = closeMenu;
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
