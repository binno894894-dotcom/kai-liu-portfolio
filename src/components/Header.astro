---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const currentPath = pathname.replace(/\/$/, '');

const navLinks = [
  { href: '/apps', label: 'Apps', isExternal: false },
  { href: '/about', label: 'About', isExternal: false },
  { href: 'https://github.com/binno894894-dotcom', label: 'GitHub', isExternal: true },
  { href: 'https://www.threads.com/@stu6yen9ineer', label: 'Threads', isExternal: true },
];
---

<header class="w-full pt-8 pb-6 border-b border-zinc-100 dark:border-zinc-900/90 mb-8 sm:mb-12">
  <div class="flex items-center justify-between">
    <!-- Brand / Name -->
    <a
      href="/"
      class="group inline-flex items-center gap-2 text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 transition-colors"
    >
      <span class="w-2 h-2 rounded-full bg-zinc-900 dark:bg-zinc-100 transition-transform group-hover:scale-125"></span>
      <span>Kai Liu</span>
    </a>

    <!-- Navigation & ThemeToggle -->
    <nav class="flex items-center gap-1 sm:gap-2">
      <div class="flex items-center gap-0.5 sm:gap-1 text-sm font-medium">
        {
          navLinks.map((link) => {
            const isActive = !link.isExternal && (currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)));
            return (
              <a
                href={link.href}
                target={link.isExternal ? '_blank' : undefined}
                rel={link.isExternal ? 'noopener noreferrer' : undefined}
                class:list={[
                  'inline-flex items-center gap-1 px-2.5 py-1.5 rounded-md transition-colors duration-150',
                  isActive
                    ? 'text-zinc-900 dark:text-zinc-100 bg-zinc-100 dark:bg-zinc-800/80 font-semibold'
                    : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-800/40'
                ]}
              >
                <span>{link.label}</span>
                {link.isExternal && (
                  <svg
                    class="w-3 h-3 opacity-60 stroke-current"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M7 7h10v10" />
                  </svg>
                )}
              </a>
            );
          })
        }
      </div>

      <div class="ml-1 pl-1 sm:ml-2 sm:pl-2 border-l border-zinc-200 dark:border-zinc-800">
        <ThemeToggle />
      </div>
    </nav>
  </div>
</header>

