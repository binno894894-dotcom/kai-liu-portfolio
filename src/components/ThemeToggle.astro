---
// ThemeToggle.astro
---

<button
  type="button"
  data-theme-toggle-btn
  aria-label="切換深淺色模式"
  class="relative inline-flex items-center justify-center w-9 h-9 rounded-xl border border-zinc-200/80 dark:border-zinc-700/60 bg-white/60 dark:bg-zinc-800/60 backdrop-blur-md text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white hover:bg-white/90 dark:hover:bg-zinc-700/70 transition-all duration-150 active:scale-90 focus:outline-none focus-visible:ring-2 focus-visible:ring-zinc-400 shadow-2xs cursor-pointer select-none"
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg
    class="w-4 h-4 hidden dark:block stroke-current transition-transform duration-200"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon Icon (shown in light mode) -->
  <svg
    class="w-4 h-4 block dark:hidden stroke-current transition-transform duration-200"
    viewBox="0 0 24 24"
    fill="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    if (window.__themeToggleInitialized) return;
    window.__themeToggleInitialized = true;

    function handleToggle(e) {
      const target = e.target;
      if (!(target instanceof Element)) return;
      const btn = target.closest('[data-theme-toggle-btn]');
      if (!btn) return;

      e.preventDefault();
      const html = document.documentElement;
      const willBeDark = !html.classList.contains('dark');
      if (willBeDark) {
        html.classList.add('dark');
        html.style.colorScheme = 'dark';
        try { localStorage.setItem('theme', 'dark'); } catch (_) {}
      } else {
        html.classList.remove('dark');
        html.style.colorScheme = 'light';
        try { localStorage.setItem('theme', 'light'); } catch (_) {}
      }
    }

    document.addEventListener('click', handleToggle);
  })();
</script>
