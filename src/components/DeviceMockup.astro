---
// DeviceMockup.astro - Easlo-inspired Android Device Mockup
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`relative mx-auto w-full max-w-[290px] sm:max-w-[310px] ${className}`}>
  <!-- Outer Device Body -->
  <div class="rounded-[38px] p-2.5 sm:p-3 border-2 border-zinc-300 dark:border-zinc-800 bg-white dark:bg-zinc-950 shadow-sm transition-all duration-300">
    <!-- Inner Screen -->
    <div class="rounded-[28px] border border-zinc-200 dark:border-zinc-800/80 bg-zinc-50/60 dark:bg-zinc-900/50 p-4 space-y-3.5 select-none">
      
      <!-- Status Bar -->
      <div class="flex items-center justify-between text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
        <span>09:41</span>
        <!-- Punch Hole Camera -->
        <div class="w-3 h-3 rounded-full bg-zinc-300 dark:bg-zinc-700 mx-auto"></div>
        <div class="flex items-center gap-1.5">
          <!-- Signal / Wifi -->
          <svg class="w-3 h-3 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.5">
            <path d="M12 20h.01M8.5 16.5a5 5 0 0 1 7 0M5 13a10 10 0 0 1 14 0" stroke-linecap="round"/>
          </svg>
          <!-- Battery -->
          <div class="w-4 h-2 rounded-[2px] border border-current flex items-center p-[1px]">
            <div class="w-2.5 h-full bg-current rounded-[1px]"></div>
          </div>
        </div>
      </div>

      <!-- App Header Bar -->
      <div class="flex items-center justify-between pt-1 border-b border-zinc-200/80 dark:border-zinc-800/80 pb-2.5">
        <div class="flex items-center gap-2">
          <img
            src="/apps/device-box-icon.png"
            alt="Device Box Icon"
            class="w-5 h-5 rounded-md object-contain"
          />
          <span class="text-xs font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Device Box</span>
        </div>
        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-200/70 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
          Android 14
        </span>
      </div>

      <!-- System Metrics Cards (Bento inside mockup) -->
      <div class="space-y-2 pt-0.5">
        <!-- CPU / SoC Block -->
        <div class="p-2.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/80 space-y-1.5">
          <div class="flex items-center justify-between text-[10px] font-mono text-zinc-400">
            <span>SOC / CPU</span>
            <span>8 Cores &bull; 3.3 GHz</span>
          </div>
          <!-- Geometric Multi-core bars -->
          <div class="grid grid-cols-8 gap-1 items-end h-5 pt-1">
            <div class="h-2/3 bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
            <div class="h-full bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
            <div class="h-3/4 bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
            <div class="h-1/2 bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
            <div class="h-5/6 bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
            <div class="h-3/5 bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
            <div class="h-4/5 bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
            <div class="h-1/2 bg-zinc-800 dark:bg-zinc-200 rounded-xs"></div>
          </div>
        </div>

        <!-- RAM / Storage Block -->
        <div class="p-2.5 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/80 space-y-1.5">
          <div class="flex items-center justify-between text-[10px] font-mono text-zinc-400">
            <span>MEMORY</span>
            <span>16 GB LPDDR5X</span>
          </div>
          <!-- Clean Segmented Bar -->
          <div class="w-full bg-zinc-200/80 dark:bg-zinc-800 h-2 rounded-full overflow-hidden flex">
            <div class="bg-zinc-900 dark:bg-zinc-100 h-full w-[64%] rounded-full"></div>
          </div>
          <div class="flex justify-between text-[9px] font-mono text-zinc-500">
            <span>Used: 10.2 GB</span>
            <span>Free: 5.8 GB</span>
          </div>
        </div>

        <!-- Battery / Display Dual Block -->
        <div class="grid grid-cols-2 gap-2">
          <!-- Battery -->
          <div class="p-2 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/80 space-y-1">
            <div class="text-[9px] font-mono text-zinc-400">BATTERY</div>
            <div class="text-xs font-bold font-mono text-zinc-900 dark:text-zinc-100">84%</div>
            <div class="text-[9px] text-zinc-500">5,000 mAh &bull; 31°C</div>
          </div>
          <!-- Display -->
          <div class="p-2 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/80 space-y-1">
            <div class="text-[9px] font-mono text-zinc-400">DISPLAY</div>
            <div class="text-xs font-bold font-mono text-zinc-900 dark:text-zinc-100">120 Hz</div>
            <div class="text-[9px] text-zinc-500">AMOLED &bull; QHD+</div>
          </div>
        </div>
      </div>

      <!-- Bottom Home Indicator -->
      <div class="pt-1 flex justify-center">
        <div class="w-20 h-1 rounded-full bg-zinc-300 dark:bg-zinc-700"></div>
      </div>

    </div>
  </div>
</div>

